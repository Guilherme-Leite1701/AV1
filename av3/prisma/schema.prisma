generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

/// A ordem é a escala de degradação (0 = NOVO ... 6 = INSERVIVEL).
enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Credencial {
  id           String       @id @default(uuid())
  usuario      String       @unique
  hashSenha    String
  salt         String
  ultimoAcesso DateTime?
  papel        PapelUsuario
  versao       Int          @default(1)
}

model ParametroGlobal {
  id            String   @id @default(uuid())
  chave         String   @unique
  valorNumerico Float
  descricao     String
  atualizadoEm  DateTime @updatedAt
}

/// Fora do UML: sequência do código de barras (uma linha por ano).
model ContadorSequencial {
  chave String @id
  valor Int    @default(0)
}

model Organizacao {
  id                String     @id @default(uuid())
  razaoSocial       String
  cnpj              String     @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime   @default(now())
  ativo             Boolean    @default(true)
  versao            Int        @default(1)
  contratoVigente   Contrato?
  lotes             Lote[]
  chavesApi         ChaveApi[]
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id])
  dataAssinatura      DateTime
  dataVencimento      DateTime
  /// Array de strings
  clausulas           Json
  valorMensal         Float
  renovacaoAutomatica Boolean
  versao              Int         @default(1)
}

model Lote {
  id                   String        @id @default(uuid())
  dataEntrada          DateTime
  organizacaoId        String
  organizacao          Organizacao   @relation(fields: [organizacaoId], references: [id])
  notaFiscal           String        @unique
  transportadora       String
  statusProcessamento  StatusLote    @default(RECEBIDO)
  observacoes          String        @default("")
  versao               Int           @default(1)
  /// AV3: marcos da triagem, usados na análise de eficiência operacional.
  dataInicioTriagem    DateTime?
  dataConclusaoTriagem DateTime?
  responsavelTriagem   String?
  equipamentos         Equipamento[]

  @@index([organizacaoId])
  @@index([dataConclusaoTriagem])
}

model Equipamento {
  id                  String             @id @default(uuid())
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Float
  loteId              String
  lote                Lote               @relation(fields: [loteId], references: [id])
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao              Int                @default(1)
  movimentacoes       Movimentacao[]

  @@index([loteId])
  @@index([statusRastreamento])
}

model Movimentacao {
  id            String      @id @default(uuid())
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  @@index([equipamentoId])
}

model JournalTransacao {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String

  @@index([entidade])
  @@index([timestamp])
}

// =============================================================================
// AV3 — camada analítica, API pública e processamento assíncrono
// =============================================================================

/// Permissões que um parceiro externo pode receber (definidas no contrato comercial).
enum EscopoApi {
  RASTREABILIDADE_LER
  LOTES_LER
  LOTES_ESCREVER
  ANALISES_LER
  RELATORIOS_GERAR
}

enum TipoAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE
  VIDA_UTIL
}

enum OrigemExecucao {
  AGENDADA
  SOB_DEMANDA
}

enum StatusTarefa {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
}

enum TipoRelatorioAssincrono {
  PREVISAO_VIDA_UTIL
  RASTREABILIDADE
  RENTABILIDADE
}

enum FormatoRelatorio {
  JSON
  CSV
}

/// Chave de API de um parceiro. Só o hash SHA-256 é guardado; o texto aparece uma única vez.
model ChaveApi {
  id              String            @id @default(uuid())
  nome            String
  prefixo         String            @unique
  hashChave       String            @unique
  escopos         EscopoApi[]
  /// null = parceiro global (ex.: auditor ambiental); senão, só enxerga os dados desta organização.
  organizacaoId   String?
  organizacao     Organizacao?      @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  limitePorMinuto Int               @default(60)
  segredoWebhook  String
  ativa           Boolean           @default(true)
  criadaPor       String
  criadaEm        DateTime          @default(now())
  expiraEm        DateTime?
  ultimoUsoEm     DateTime?
  revogadaEm      DateTime?
  versao          Int               @default(1)
  tarefas         TarefaRelatorio[]

  @@index([organizacaoId])
}

/// Cabeçalho de cada execução de análise: guarda parâmetros e resultado para consulta histórica.
model ExecucaoAnalise {
  id          String             @id @default(uuid())
  tipo        TipoAnalise
  origem      OrigemExecucao
  solicitante String
  parametros  Json
  resultado   Json
  amostras    Int
  iniciadaEm  DateTime
  concluidaEm DateTime           @default(now())
  duracaoMs   Int
  previsoes   PrevisaoVidaUtil[]

  @@index([tipo, concluidaEm])
}

/// Modelo de regressão de cada tipo de equipamento, versionado por execução (previsto × realizado).
model PrevisaoVidaUtil {
  id                  String          @id @default(uuid())
  execucaoId          String
  execucao            ExecucaoAnalise @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  tipoEquipamento     TipoEquipamento
  metodo              String
  amostras            Int
  coeficienteAngular  Float
  intercepto          Float
  r2                  Float
  idadeInservivelAnos Float?
  /// Diferença para a previsão anterior do mesmo tipo (anos); null na primeira.
  variacaoAnos        Float?
  criadaEm            DateTime        @default(now())

  @@index([tipoEquipamento, criadaEm])
}

/// Relatório pedido pela API e gerado em segundo plano pela fila.
model TarefaRelatorio {
  id                String                  @id @default(uuid())
  tipo              TipoRelatorioAssincrono
  formato           FormatoRelatorio
  status            StatusTarefa            @default(PENDENTE)
  chaveApiId        String?
  chaveApi          ChaveApi?               @relation(fields: [chaveApiId], references: [id])
  solicitante       String
  organizacaoId     String?
  tentativas        Int                     @default(0)
  erro              String?
  conteudo          String?
  nomeArquivo       String?
  tamanhoBytes      Int?
  webhookUrl        String?
  webhookEntregueEm DateTime?
  criadaEm          DateTime                @default(now())
  iniciadaEm        DateTime?
  concluidaEm       DateTime?
  expiraEm          DateTime?

  @@index([chaveApiId, criadaEm])
  @@index([status])
}
