# Copie para .env e ajuste se necessário.

DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"

# Opcional: se vazio, os testes usam o DATABASE_URL com schema "testes".
# DATABASE_URL_TESTE="postgresql://greencode:greencode@localhost:5432/greencode?schema=testes"

# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-pelo-menos-32-caracteres"

HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Mostra o SQL gerado pelo Prisma:
# PRISMA_LOG=query

# ----------------------------------------------------------------- AV3
# Redis da fila (BullMQ) e do limite de requisições. Sem ele, a fila fica em
# memória e o worker roda dentro do servidor (bom para desenvolvimento).
# REDIS_URL="redis://localhost:6379"

# true = o servidor também processa a fila; false = rode "npm run worker" à parte.
WORKER_EMBUTIDO=true
WORKER_CONCORRENCIA=2

# Rotinas (cron, fuso America/Sao_Paulo): análises diárias e limpeza de relatórios.
CRON_ANALISES="0 2 * * *"
CRON_LIMPEZA="15 * * * *"

# Swagger UI em /docs
SWAGGER_HABILITADO=true

# Webhooks só em https; libere http apenas para testar localmente.
WEBHOOK_PERMITIR_HTTP=false
#51 vezes Paranaense, 2 vezes série B