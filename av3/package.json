{
  "name": "greencode-av3",
  "version": "3.0.0",
  "description": "greencode AV3 — monólito Fastify + Prisma com camada analítica, API pública (chaves, rate limit, OpenAPI) e relatórios assíncronos (BullMQ)",
  "private": true,
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "test:todos": "npm run test && npm run test:integracao"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.6",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "node-cron": "^4.6.0",
    "simple-statistics": "^7.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
