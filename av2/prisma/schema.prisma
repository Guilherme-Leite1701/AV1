generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

/// A ordem é a escala de degradação (0 = NOVO ... 6 = INSERVIVEL).
enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Credencial {
  id           String       @id @default(uuid())
  usuario      String       @unique
  hashSenha    String
  salt         String
  ultimoAcesso DateTime?
  papel        PapelUsuario
  versao       Int          @default(1)
}

model ParametroGlobal {
  id            String   @id @default(uuid())
  chave         String   @unique
  valorNumerico Float
  descricao     String
  atualizadoEm  DateTime @updatedAt
}

/// Fora do UML: sequência do código de barras (uma linha por ano).
model ContadorSequencial {
  chave String @id
  valor Int    @default(0)
}

model Organizacao {
  id                String    @id @default(uuid())
  razaoSocial       String
  cnpj              String    @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime  @default(now())
  ativo             Boolean   @default(true)
  versao            Int       @default(1)
  contratoVigente   Contrato?
  lotes             Lote[]
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id])
  dataAssinatura      DateTime
  dataVencimento      DateTime
  /// Array de strings
  clausulas           Json
  valorMensal         Float
  renovacaoAutomatica Boolean
  versao              Int         @default(1)
}

model Lote {
  id                  String        @id @default(uuid())
  dataEntrada         DateTime
  organizacaoId       String
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id])
  notaFiscal          String        @unique
  transportadora      String
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String        @default("")
  versao              Int           @default(1)
  equipamentos        Equipamento[]

  @@index([organizacaoId])
}

model Equipamento {
  id                  String             @id @default(uuid())
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Float
  loteId              String
  lote                Lote               @relation(fields: [loteId], references: [id])
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao              Int                @default(1)
  movimentacoes       Movimentacao[]

  @@index([loteId])
  @@index([statusRastreamento])
}

model Movimentacao {
  id            String      @id @default(uuid())
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  @@index([equipamentoId])
}

model JournalTransacao {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String

  @@index([entidade])
  @@index([timestamp])
}
