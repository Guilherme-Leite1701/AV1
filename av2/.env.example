# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-pelo-menos-32-caracteres"

HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

