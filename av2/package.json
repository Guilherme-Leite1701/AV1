{
  "name": "greencode-av2",
  "version": "2.0.0",
  "description": "greencode AV2 — servidor HTTP monolítico em camadas (Fastify + Prisma + PostgreSQL) para logística reversa de resíduos eletrônicos",
  "private": true,
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "test:todos": "npm run test && npm run test:integracao"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
